declare query_parameters(vulnerability_id:string, as_of:datetime);
VulnerabilityFindings
| where VulnerabilityId == vulnerability_id and ObservedAt <= as_of
| summarize arg_max(ObservedAt, Status) by DeviceId, VulnerabilityId
| where Status == "Open"
| join kind=inner (
    DeviceUsers
    | where isnotempty(UserId)
    | distinct DeviceId, UserId
) on DeviceId
| distinct UserId
| summarize AffectedUsers = count()
